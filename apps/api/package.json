{
  "name": "@jobtracker/api",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply faisalownedjobtracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply faisalownedjobtracker --remote",
    "db:migrate": "wrangler d1 migrations apply faisalownedjobtracker --local"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@jobtracker/constants": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.2",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.8",
    "http-status-codes": "^2.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6",
    "wrangler": "^4.110.0"
  }
}
